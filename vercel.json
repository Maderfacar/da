{
  "framework": "nuxtjs",
  "installCommand": "npm install -g pnpm@10.33.2 && pnpm install",
  "buildCommand": "pnpm build",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/cleanup-error-logs",
      "schedule": "23 18 * * *"
    },
    {
      "path": "/api/cron/alert-auth-health",
      "schedule": "0 * * * *"
    }
  ]
}
